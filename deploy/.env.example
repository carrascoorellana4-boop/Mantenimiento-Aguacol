# Copiar a ~/mantenimiento/.env en el servidor y completar. NUNCA subir el .env real a GitHub.
JWT_SECRET=            # 48 bytes en hex
ANON_KEY=              # JWT HS256 firmado con JWT_SECRET, claim role=mant_anon
SERVICE_KEY=           # JWT HS256 firmado con JWT_SECRET, claim role=service_role
OWNER_PW=
AUTHENTICATOR_PW=
SUPABASE_AUTH_PW=
PUBLIC_URL=https://mantenimiento.aguacol.cl
TUNNEL_TOKEN=          # token del túnel de Cloudflare
